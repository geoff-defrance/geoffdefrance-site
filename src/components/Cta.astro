---
import { bookingHref } from '../site.config';
interface Props { headline: string; body?: string; secondary?: { label: string; href: string } }
const { headline, body, secondary } = Astro.props;
const external = bookingHref.startsWith('http');
---
<section class="cta" aria-labelledby="cta-heading">
  <div class="wrap">
    <h2 id="cta-heading">{headline}</h2>
    {body && <p class="cta-body">{body}</p>}
    <div class="cta-actions">
      <a class="btn btn--light" href={bookingHref} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>Book a 30-minute call</a>
      {secondary && <a class="cta-link" href={secondary.href}>{secondary.label}</a>}
    </div>
  </div>
</section>
<style>
  .cta { background: var(--color-inverse-bg); color: var(--color-inverse-text); text-align: center; padding: 112px 0; }
  h2 { font-size: clamp(2.4rem, 5vw, 3.75rem); letter-spacing: -0.025em; }
  .cta-body { margin: 24px auto 0; max-width: 620px; font-size: 1.15rem; color: var(--color-inverse-muted); }
  .cta-actions { margin-top: 40px; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 28px; }
  .cta-link { color: var(--color-inverse-text); font-weight: 500; }
  .cta-link:hover { color: #fff; }
</style>
