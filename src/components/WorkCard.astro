---
interface Props { href: string; label: string; title: string; summary: string; metric: string; metricLabel: string; headingLevel?: 'h2' | 'h3' }
const { href, label, title, summary, metric, metricLabel, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<a class="card" href={href}>
  <p class="label">{label}</p>
  <H class="card-title">{title}</H>
  <p class="card-summary">{summary}</p>
  <div class="numeral card-metric">{metric}</div>
  <p class="card-metric-label">{metricLabel}</p>
</a>
<style>
  .card { display: block; border-top: 1px solid var(--color-rule); padding-top: 24px; color: var(--color-text); text-decoration: none; }
  .card:hover .card-title { color: var(--color-accent); text-decoration: underline; text-decoration-thickness: 1px; }
  .card-title { font-size: 1.5rem; line-height: 1.22; margin: 0 0 12px; }
  .card-summary { font-size: 16px; color: var(--color-text-muted); margin: 0; }
  .card-metric { margin-top: 24px; font-size: 2.5rem; }
  .card-metric-label { margin: 8px 0 0; font-size: 14px; color: var(--color-text-muted); }
</style>
