---
import { SITE } from '../site.config';
interface Props { label?: string; align?: 'start' | 'center' }
const { label = SITE.logosLabel, align = 'start' } = Astro.props;
const logos = (SITE.logos ?? []) as { name: string; src: string; height?: number }[];
---
{logos.length > 0 && (
  <div class:list={['logo-row', `logo-row--${align}`]}>
    <p class="label">{label}</p>
    <ul>
      {logos.map((l) => (
        <li><img src={l.src} alt={l.name} title={l.name} style={`height:${l.height ?? 26}px`} loading="lazy" decoding="async" /></li>
      ))}
    </ul>
  </div>
)}
<style>
  .logo-row ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 28px 48px; }
  .logo-row--center { text-align: center; }
  .logo-row--center ul { justify-content: center; }
  .logo-row img { width: auto; max-width: 100%; opacity: 0.72; filter: grayscale(1); }
  @media (max-width: 640px) { .logo-row ul { gap: 22px 32px; } .logo-row img { transform: scale(0.88); transform-origin: left center; } }
</style>
