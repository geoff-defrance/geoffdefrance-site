---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { ld } from '../../lib/schema';
import { SITE } from '../../site.config';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((w) => ({ params: { slug: w.id }, props: { entry: w } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const schema = ld({
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  author: { '@type': 'Person', '@id': `${SITE.url}/#person`, name: SITE.name, url: `${SITE.url}/` },
  publisher: { '@type': 'Person', name: SITE.name },
  url: new URL(Astro.url.pathname, SITE.url).href,
  about: [...d.industry, ...d.capability],
});
---
<Base title={d.seoTitle} description={d.description} schema={schema} ogType="article">
  <article>
    <header class="wrap page-hero">
      <p class="label"><a href="/work/">Work</a> · {d.industry.join(' · ')}</p>
      <h1>{d.title}</h1>
    </header>
    <section class="wrap glance" aria-label="At a glance">
      <div class="glance-metric">
        {d.logo && <img class="company-logo" src={d.logo} alt={d.logoAlt ?? ''} loading="eager" decoding="async" />}
        <div class="numeral">{d.metric}</div>
        <p class="muted">{d.metricLabel}</p>
      </div>
      <dl>
        {d.glance.map((g) => (<div><dt>{g.label}</dt><dd>{g.value}</dd></div>))}
      </dl>
    </section>
    <section class="section">
      <div class="wrap"><div class="prose">
        <Content />
        {d.quote && (
          <figure class="quote">
            <blockquote><p>“{d.quote.text}”</p></blockquote>
            <figcaption>{d.quote.attribution}</figcaption>
          </figure>
        )}
      </div></div>
    </section>
  </article>
  <Cta headline={d.ctaHeadline} secondary={d.ctaSecondary} />
</Base>
<style>
  .page-hero { padding-top: 96px; padding-bottom: 48px; }
  .page-hero h1 { max-width: 960px; font-size: clamp(2.2rem, 4.6vw, 3.75rem); }
  .page-hero .label a { color: inherit; }
  .glance { display: grid; gap: 40px; grid-template-columns: minmax(0, 260px) minmax(0, 1fr); padding-bottom: 72px; }
  .company-logo { display: block; height: 30px; width: auto; max-width: 100%; margin-bottom: 24px; opacity: 0.72; }
  .glance-metric .numeral { font-size: clamp(2.6rem, 4.2vw, 3.5rem); white-space: nowrap; }
  .glance-metric p { margin: 10px 0 0; font-size: 15px; }
  dl { margin: 0; border-top: 1px solid var(--color-rule); }
  dl div { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--color-rule); font-size: 16px; }
  dt { font-weight: 600; }
  dd { margin: 0; }
  .quote { margin: 64px 0 0; padding-left: 24px; border-left: 2px solid var(--color-accent); }
  .quote blockquote { margin: 0; padding: 0; border: 0; }
  .quote p { margin: 0; font-family: var(--font-display); font-style: italic; font-size: 1.4rem; line-height: 1.45; }
  .quote figcaption { margin-top: 16px; font-size: 15px; color: var(--color-text-muted); }
  @media (max-width: 760px) {
    .page-hero { padding-top: 56px; }
    .glance { grid-template-columns: 1fr; padding-bottom: 48px; }
    dl div { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
