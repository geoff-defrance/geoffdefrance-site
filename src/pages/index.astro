---
import { getEntry, getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import WorkCard from '../components/WorkCard.astro';
import Headshot from '../components/Headshot.astro';
import LogoRow from '../components/LogoRow.astro';
import { SITE } from '../site.config';
import { bookingHref } from '../site.config';
import { ld, person, business } from '../lib/schema';

const home = (await getEntry('pages', 'home'))!;
const d = home.data as any;
const work = await getCollection('work');
const featured = d.featured.map((slug: string) => work.find((w) => w.id === slug)).filter(Boolean);
const external = bookingHref.startsWith('http');
const schema = [ld({ '@graph': [person, business] })];
// Headshot size is set in Pages CMS (Home page › Headshot size / width).
const sizes: Record<string, number> = { small: 160, medium: 240, large: 320 };
const showHeadshot = d.headshotShow !== false;
const headshotWidth = Number(d.headshotWidth) > 0 ? Number(d.headshotWidth) : sizes[d.headshotSize ?? 'medium'] ?? 240;
---
<Base title={d.seoTitle} description={d.description} schema={schema}>
  <section class="hero wrap">
    <div class="hero-text">
      <p class="label label--accent">{d.eyebrow}</p>
      <h1>{d.title}</h1>
      <p class="lede hero-sub">{d.subhead}</p>
      <div class="actions">
        <a class="btn" href={bookingHref} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>Book a 30-minute call</a>
        <a class="textlink" href="/work/">See the work</a>
      </div>
    </div>
    {showHeadshot && (
      <figure class="hero-photo">
        <Headshot size={headshotWidth} mobileSize={Math.min(headshotWidth, 120)} eager />
        <figcaption><strong>{SITE.personName}</strong><br />{SITE.personTitle}, {SITE.name}</figcaption>
      </figure>
    )}
  </section>

  <section class="section section--alt" aria-labelledby="results">
    <div class="wrap">
      <h2 id="results" class="label">Results</h2>
      <div class="proof">
        {d.proof.map((p: any, i: number) => (
          <div>
            {p.label && <p class="proof-label">{String(i + 1).padStart(2, '0')} · {p.label}</p>}
            <div class="numeral">{p.figure}</div>
            <p class="proof-text"><strong>{p.lead}</strong> {p.detail}</p>
          </div>
        ))}
      </div>
      <div class="previously">{(SITE.logos?.length ? <LogoRow /> : <p class="muted">Previously at {d.previouslyAt}</p>)}</div>
    </div>
  </section>

  <section class="wrap ways" aria-labelledby="ways">
    <h2 id="ways">Three ways to work together</h2>
    <div class="grid ways-grid">
      {d.ways.map((w: any) => (
        <article class="way">
          <p class="label label--accent">{w.label}</p>
          <h3>{w.title}</h3>
          <p>{w.body}</p>
          <a href={w.linkHref}>{w.linkLabel}</a>
        </article>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="work">
    <div class="wrap">
      <div class="section-head">
        <h2 id="work">Featured work</h2>
        <a href="/work/">All case studies</a>
      </div>
      <div class="grid">
        {featured.map((w: any) => (
          <WorkCard href={`/work/${w.id}/`} label={w.data.industry.join(' · ')} title={w.data.cardTitle} summary={w.data.summary} metric={w.data.metric} metricLabel={w.data.metricLabel} />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="how">
    <div class="wrap">
      <h2 id="how">How I work</h2>
      <div class="how-grid">
        {d.how.map((h: any) => (
          <div>
            <h3 class="how-title">{h.title}</h3>
            <p class="muted">{h.body}</p>
          </div>
        ))}
      </div>
      <figure class="testimonial">
        <blockquote><p>“{d.testimonial.text}”</p></blockquote>
        <figcaption>{d.testimonial.attribution}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="about">
    <div class="wrap about">
      {!showHeadshot && <Headshot size={300} />}
      <div class="about-text">
        <h2 id="about">{d.aboutHeadline}</h2>
        <p>{d.aboutBody}</p>
        <a href="/about/">More about me</a>
      </div>
    </div>
  </section>

  <Cta headline={d.ctaHeadline} body={d.ctaBody} />
</Base>

<style>
  .hero { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 40px 64px; padding-top: 112px; padding-bottom: 96px; }
  .hero-text { flex: 1 1 520px; min-width: 0; }
  .hero h1 { max-width: 920px; }
  .hero-photo { flex: 0 0 auto; margin: 8px 0 0; max-width: 100%; }
  .hero-photo figcaption { margin-top: 14px; font-size: 14px; line-height: 1.45; color: var(--color-text-muted); }
  .hero-photo figcaption strong { color: var(--color-text); font-weight: 600; }
  @media (max-width: 900px) { .hero-photo { order: -1; margin-top: 0; display: flex; align-items: center; gap: 20px; } .hero-photo figcaption { margin-top: 0; } }
  .hero-sub { margin-top: 32px; }
  .proof { display: grid; gap: 40px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); }
  .proof .numeral { font-size: clamp(2.4rem, 3.6vw, 3.25rem); white-space: nowrap; }
  .proof-label { margin: 0 0 14px; font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); }
  .proof-text { margin: 16px 0 0; font-size: 16px; line-height: 1.5; }
  .proof-text strong { font-weight: 600; }
  .previously { margin: 56px 0 0; padding-top: 32px; border-top: 1px solid var(--color-rule); font-size: 15px; }
  .ways { padding-top: 104px; padding-bottom: 104px; }
  .ways h2 { margin-bottom: 56px; }
  .way { border-top: 2px solid var(--color-text); padding-top: 24px; }
  .way h3 { margin: 0 0 16px; }
  .way p { font-size: 17px; }
  .way a { font-size: 16px; font-weight: 500; }
  .section-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 48px; }
  .section-head a { font-weight: 500; font-size: 16px; }
  #how { margin-bottom: 48px; }
  .how-grid { display: grid; gap: 40px 64px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); }
  .how-title { font-family: var(--font-body); font-size: 18px; font-weight: 600; letter-spacing: 0; margin-bottom: 8px; }
  .how-grid p { font-size: 17px; margin: 0; }
  .testimonial { margin: 72px 0 0; padding-left: 28px; border-left: 2px solid var(--color-accent); max-width: 800px; }
  .testimonial blockquote { margin: 0; }
  .testimonial p { margin: 0; font-family: var(--font-display); font-style: italic; font-size: clamp(1.35rem, 2.4vw, 1.8rem); line-height: 1.4; }
  .testimonial figcaption { margin-top: 16px; font-size: 15px; color: var(--color-text-muted); }
  .about { display: flex; flex-wrap: wrap; align-items: center; gap: 56px; }
  .about-text { flex: 999 1 420px; min-width: 0; max-width: 680px; }
  .about-text h2 { margin-bottom: 20px; font-size: 2.25rem; }
  .about-text a { font-weight: 500; font-size: 16px; }
  @media (max-width: 640px) { .hero { padding-top: 64px; padding-bottom: 64px; } .ways { padding-top: 64px; padding-bottom: 64px; } }
</style>
