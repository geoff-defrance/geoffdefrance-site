---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { ld, faqPage, person } from '../../lib/schema';
import { SITE } from '../../site.config';

const page = (await getEntry('pages', 'services'))!;
const d = page.data as any;
const live = d.offers.filter((o: any) => !o.comingSoon && o.linkHref);
const schema = [
  ld({ '@type': 'ItemList', itemListElement: live.map((o: any, i: number) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Service', name: o.title, url: `${SITE.url}${o.linkHref}`, provider: { '@id': person['@id'] } } })) }),
  ...(d.faqs?.length ? [faqPage(d.faqs)] : []),
];
---
<Base title={d.seoTitle} description={d.description} schema={schema}>
  <section class="wrap page-hero">
    <h1>{d.title}</h1>
    <p class="lede">{d.intro}</p>
  </section>

  <section class="section">
    <div class="wrap offers">
      {d.offers.map((o: any) => (
        <article class:list={['offer', { 'offer--soon': o.comingSoon }]}>
          <p class:list={['label', { 'label--accent': !o.comingSoon }]}>{o.label}{o.comingSoon && ' · coming soon'}</p>
          <h2>{o.title}</h2>
          {o.whoFor && <p><strong>Who it's for:</strong> {o.whoFor}</p>}
          {o.whatYouGet && <p><strong>What you get:</strong> {o.whatYouGet}</p>}
          {o.body && <p>{o.body}</p>}
          {o.linkHref && <a href={o.linkHref}>{o.linkLabel}</a>}
        </article>
      ))}
    </div>
  </section>

  {d.faqs?.length > 0 && (
    <section class="section section--alt" aria-labelledby="faq">
      <div class="wrap measure">
        <h2 id="faq">Questions</h2>
        <dl class="faq">{d.faqs.map((f: any) => (<><dt>{f.q}</dt><dd>{f.a}</dd></>))}</dl>
      </div>
    </section>
  )}
  <Cta headline={SITE.ctaHeadline} body={SITE.ctaBody} />
</Base>
<style>
  .page-hero { padding-top: 96px; padding-bottom: 72px; }
  .page-hero h1 { margin-bottom: 28px; }
  .offers { display: grid; gap: 56px 64px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); }
  .offer { border-top: 2px solid var(--color-text); padding-top: 24px; }
  .offer--soon { border-top-color: var(--color-rule); }
  .offer h2 { font-size: 1.75rem; margin-bottom: 16px; }
  .offer p { font-size: 17px; }
  .offer > a { font-weight: 500; font-size: 16px; }
  #faq { margin-bottom: 32px; }
  .faq dt { font-weight: 600; margin-top: 28px; }
  .faq dd { margin: 6px 0 0; color: var(--color-text-muted); }
  @media (max-width: 640px) { .page-hero { padding-top: 56px; padding-bottom: 48px; } }
</style>
