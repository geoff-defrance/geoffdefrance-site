---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
const page = (await getEntry('pages', 'privacy'))!;
const { Content } = await render(page);
---
<Base title={page.data.seoTitle} description={page.data.description}>
  <section class="wrap page-hero"><div class="prose">
    <h1>{page.data.title}</h1>
    <Content />
  </div></section>
</Base>
<style>.page-hero { padding-top: 96px; padding-bottom: 96px; } h1 { margin-bottom: 32px; }</style>
