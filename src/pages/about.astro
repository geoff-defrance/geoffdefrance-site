---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import Headshot from '../components/Headshot.astro';
import LogoRow from '../components/LogoRow.astro';
import { ld, person } from '../lib/schema';
import { SITE } from '../site.config';

const entry = (await getEntry('pages', 'about'))!;
const { Content } = await render(entry);
const schema = ld({ '@type': 'ProfilePage', mainEntity: person, url: `${SITE.url}/about/` });
---
<Base title={entry.data.seoTitle} description={entry.data.description} schema={schema}>
  <section class="wrap page-hero">
    <div class="intro">
      <Headshot size={360} mobileSize={240} eager />
      <div>
        <h1>{entry.data.title}</h1>
        <p class="label">{SITE.personName} · {SITE.personTitle}, {SITE.name}</p>
        <p class="lede">Product and technology leader for subscription, media and eCommerce businesses.</p>
        <p class="profile-links"><a href={SITE.linkedin} rel="me noopener" target="_blank">LinkedIn profile</a>{SITE.cvFile && <> · <a href={SITE.cvFile} target="_blank" rel="noopener">Download my CV (PDF)</a></>}</p>
      </div>
    </div>
  </section>
  <section class="section section--alt logos">
    <div class="wrap"><LogoRow label="Where I've worked" /></div>
  </section>
  <section class="section">
    <div class="wrap"><div class="prose"><Content /></div></div>
  </section>
  <Cta headline={SITE.ctaHeadline} body={SITE.ctaBody} />
</Base>
<style>
  .logos { padding: 48px 0; }
  .page-hero { padding-top: 96px; padding-bottom: 72px; }
  .intro { display: flex; flex-wrap: wrap; align-items: center; gap: 48px; }
  .intro > div { flex: 999 1 420px; min-width: 0; }
  .intro h1 { margin-bottom: 20px; }
  .intro .label { margin-bottom: 12px; }
  .profile-links { margin-top: 16px; font-size: 16px; font-weight: 500; }
  @media (max-width: 640px) { .page-hero { padding-top: 48px; } }
</style>
